<?xml version="1.0" encoding="UTF-8"?>
<!--
  时间 MCP Server：独立 Spring Boot 应用（非 web），通过 stdio 对外提供 getCurrentTime 工具。
  Hagent 主应用作为 MCP 客户端，配置拉起它并把工具交给模型。

  为什么是独立项目而不是主应用里的一个类：
    ① 主应用只做客户端：引入 server starter 会让主应用自己也变成 server；
    ② 边界清晰：server 看不到主应用的知识库 / 记忆 / 数据库；
    ③ 可替换：换语言/换实现只改 application-mcp.yml 里的一行命令。

  版本与主应用对齐：Spring Boot 4.1.1 / Spring AI 2.0.1（GA）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.hagent.mcp</groupId>
    <artifactId>time-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>hagent-time-mcp-server</name>
    <description>时间 MCP Server（stdio）—— 给 Hagent 提供"当前时间"这一个工具</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencies>
        <!-- stdio 版 MCP server starter：server 自动配置 + MCP Java SDK + @McpTool 注解扫描 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
            <version>${spring-ai.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打成可执行 jar：客户端用 `java -jar ...` 拉起它 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
