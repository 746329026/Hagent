<?xml version="1.0" encoding="UTF-8"?>
<!--
  时间 MCP Server 的日志配置 —— 唯一目的：别弄脏 stdout。

  MCP 的 stdio 形态用 stdin/stdout 传 JSON-RPC，而 Spring Boot 默认把日志写到 stdout。
  日志混进协议帧后，症状极具误导性：server 活着、日志正常，客户端却一个工具都拿不到
  （握手帧解析失败）—— 两侧都觉得自己没问题。

  ⇒ 把控制台 appender 的 target 改成 System.err；stdout 只留给协议。
-->
<configuration>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>

</configuration>
