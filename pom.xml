<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
      Hagent · 高扩展性企业办公 Agent

      版本策略：全部使用最新 GA 稳定版，禁用里程碑版（API 未冻结、无安全维护）。
      依赖原则：每个依赖都要有明确用途。当前暂未启用的扩展依赖（MyBatis-Plus / POI /
      PDF & Markdown Reader）在各自注释里写明它将来为哪块能力铺垫，不做无名预留。

      注意：XML 注释内不允许出现连续两个连字符，因此本文件用 ===== 分节。
    -->

    <modelVersion>4.0.0</modelVersion>

    <!-- 项目坐标：别人引用本项目的唯一身份证 -->
    <groupId>com.hagent</groupId>
    <artifactId>hagent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>hagent</name>
    <description>高扩展性企业办公 Agent（Spring AI + 手工 RAG + 多步 Agent + 双层记忆）</description>

    <!-- 继承 Spring Boot 的版本仲裁与插件默认配置 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-ai.version>2.0.1</spring-ai.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <poi.version>5.4.1</poi.version>
    </properties>

    <!--
      dependencyManagement 只"管版本"不"引依赖"。
      Spring AI 有几十个模块，用 BOM（import + pom scope）统一仲裁，避免逐模块写版本导致不匹配。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- MyBatis-Plus 不在 Spring Boot 仲裁清单里，版本必须写死 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Web 服务：内嵌 Tomcat + Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@Valid 在业务代码之前拦非法输入，异常由全局处理器统一转 {code,message} -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          模型接入：chat 上云（DeepSeek）、embedding 在本地（Ollama），是成本决策而非"多接一家"。
          ★ 两个 starter 同时存在时都会创建 ChatModel Bean，启动会报 "found 2"。
            解法是在 application.yml 里显式声明能力归属（model.chat / model.embedding），
            不是用 @Primary 打补丁；ollama 的 pull-model-strategy 只阻止拉模型，不阻止建 Bean。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!--
          四种存储各司其职：
            pgvector = 向量索引；MySQL = 业务主库；Redis = 缓存/上下文；.md = 长期记忆。
        -->

        <!--
          向量库：默认实现（通过 BOM 仲裁版本）。
          注意：PostgreSQL 驱动由它传递引入；spring-boot-starter-jdbc / HikariCP 也来自它 ——
          业务主库的连接能力目前挂在这条传递链上（已知耦合，见 README 说明）。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!--
          MCP 客户端（阶段 16）：工具来自独立进程（MCP/time-server 这类项目）。
          只做客户端，不引入 server starter —— 否则主应用自己也会对外提供 MCP 端点。
          ★ 它会自动注册 SyncMcpToolCallbackProvider，与我们的 ToolRegistration 同类型冲突，
            故在 application.yml 里关闭（spring.ai.mcp.client.toolcallback.enabled=false），
            工具清单统一由 ToolRegistration 合并（唯一注册入口）。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!--
          业务持久层（扩展铺垫，当前未使用）：现在所有 SQL 都经 JdbcTemplate 直接执行，
          MyBatis 的 API 一行未引用。保留它，是为将来"复杂条件查询 / 报表 / 分页"这类
          用 JdbcTemplate 写会明显变啰嗦的场景做准备；届时不需再改依赖。
          （若确认永远不用，可删；但 HikariCP 由 pgvector starter 提供，删它不影响数据源。）
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <!-- MySQL JDBC 驱动：代码只写 jdbc:mysql:// 字符串，靠类名反射加载，故 scope=runtime -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis 同步客户端：本项目是 Spring MVC + SseEmitter，不用 WebFlux 全栈，不需要 reactive 版 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          文档解析（扩展铺垫）：
            markdown reader —— 当前未使用：.md 由 SourceLoader 手工解析 frontmatter（依赖 snakeyaml）；
            pdf reader      —— 当前未使用：SourceLoader 只支持 .md / .txt（PDF 入库是后续能力）。
          保留它们，是为"改用框架 reader / 支持 PDF 企业制度文件"准备的，不是当前运行路径。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-markdown-document-reader</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pdf-document-reader</artifactId>
        </dependency>

        <!--
          办公产出（扩展铺垫，当前未使用）：POI 用于将来生成 PPT / Excel 等交付物，
          当前项目的产出是文本回答，故一行代码未引用。
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!--
          Lombok：编译期注解处理器，运行期不需要（optional）。
          annotationProcessorPaths 显式声明它：不写只是"碰巧能用"（javac 扫描 classpath），
          显式声明才是"保证能用"，并锁定处理器版本。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试：starter-test 已含 JUnit 5 / Mockito / AssertJ；流式测试另需 reactor-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          架构守卫（ArchUnit）：管"包级无环"与分层方向。
          只用 core 制品，不用 archunit-junit5 —— 本项目 JUnit 是 6.x，后者会把 junit-platform 5.x 拽进来。
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>

        <!--
          SnakeYAML：SourceLoader 用它解析 .md 头部的 frontmatter。
          虽然它会经 spring-boot-starter 传递进来，但代码里【直接 import】的库应显式声明，
          不然将来 Boot 换实现就会在无征兆下编译失败。
        -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!--
              编译插件：
                1) parameters=true —— 保留方法参数名，Spring 的构造器注入与参数名推断依赖它；
                2) annotationProcessorPaths —— 显式声明 Lombok 处理器（JSR-269）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- 打包成可执行 jar（内含 Tomcat），并排除编译期依赖 Lombok -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
