# ============================================================================
# 本地私有配置模板
#
#   ★ 这个 .example 文件可以进仓库（它不含任何真实密钥）
#   ★ 真正使用的 application-local.yml 已被 .gitignore 排除，绝不进仓库
#
#   首次使用：
#     copy src\main\resources\application-local.yml.example src\main\resources\application-local.yml
#   然后填入真实值。
#
#   密钥也可以完全不落盘 —— 用环境变量注入（推荐）：
#     $env:DEEPSEEK_API_KEY="sk-xxxx"
#   此时下面的 api-key 保持 ${DEEPSEEK_API_KEY:} 即可。
# ============================================================================

spring:
  # ---------------- 业务主库：MySQL ----------------
  # 归属决策：使用项目专属容器 hagent-mysql（端口 3307），
  # 不用宿主机 3306 上的原生 MySQL，避免污染其它项目、保证版本可复现。
  datasource:
    url: jdbc:mysql://localhost:3307/hagent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: "hagent123"
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2
      connection-timeout: 5000
      pool-name: HagentMysqlPool

  # 建表交给显式 DDL（阶段 6 起），不让框架自动改表结构
  jpa:
    hibernate:
      ddl-auto: none
    open-in-view: false
    show-sql: false

  # ---------------- Redis：缓存 + 会话记忆 ----------------
  # 本地容器 hagent-redis（valkey/valkey:8，协议与 Redis 完全兼容）
  data:
    redis:
      host: localhost
      port: 6379
      timeout: 3s
      lettuce:
        pool:
          max-active: 16
          max-idle: 8
          min-idle: 2

  sql:
    init:
      mode: never

  ai:
    # ---------------- 密钥 ----------------
    # 推荐：环境变量注入，密钥完全不落盘
    #   $env:DEEPSEEK_API_KEY="sk-xxxx"
    # 也可以直接写在冒号后面（本文件不进仓库）
    deepseek:
      api-key: "${DEEPSEEK_API_KEY:}"

logging:
  level:
    com.hagent: DEBUG