# ============================================================================
# 本地私有配置模板
#
#   ★ 本文件不含真实密钥，可以进仓库；真正使用的 application-local.yml
#     已被 .gitignore 排除，绝不进仓库。
#
#   首次使用：
#     copy src\main\resources\application-local.yml.example src\main\resources\application-local.yml
#   然后填入真实值。密钥推荐用环境变量注入（不落盘）：
#     $env:DEEPSEEK_API_KEY="sk-xxxx"
# ============================================================================

spring:
  # ---------------- 业务主库：MySQL ----------------
  # 用项目专属容器 hagent-mysql（端口 3307），不污染宿主机其它 MySQL。
  datasource:
    url: jdbc:mysql://localhost:3307/hagent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: "hagent123"
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2
      connection-timeout: 5000
      pool-name: HagentMysqlPool

  # 本项目没有 JPA / Hibernate：建表方式固定为【显式 DDL】（src/main/resources/db/*.sql），
  # 表结构可评审、可版本化，不会被框架悄悄改掉。
  # （依赖里的 hibernate-validator 是【参数校验】实现，与 ORM 无关。）
  #
  # 持久层当前用 JdbcTemplate 直接执行 SQL；pom 里的 MyBatis-Plus 是为复杂查询/报表预留的
  # 扩展铺垫，当前没有 Mapper 接口，也不需要任何 mybatis 配置。

  # ---------------- Redis：缓存 + 会话上下文 ----------------
  # 本地容器 hagent-redis（valkey/valkey:8，协议与 Redis 兼容）
  data:
    redis:
      host: localhost
      port: 6379
      timeout: 3s
      lettuce:
        pool:
          max-active: 16
          max-idle: 8
          min-idle: 2

  sql:
    init:
      # 建表由显式 DDL 完成，关闭框架的 schema 初始化
      mode: never

  ai:
    # ---------------- 密钥 ----------------
    # 推荐环境变量注入；也可直接写在冒号后面（本文件不进仓库）
    deepseek:
      api-key: "${DEEPSEEK_API_KEY:}"

logging:
  level:
    com.hagent: DEBUG
